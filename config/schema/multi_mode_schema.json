{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "version",
        "default_mode",
        "api_key",
        "system_governance",
        "cortex_llm",
        "modes"
    ],
    "properties": {
        "version": {"type": "string", "description": "The version of the configuration schema."},
        "default_mode": {"type": "string", "description": "The mode to initialize on startup."},
        "allow_manual_switching": {"type": "boolean", "description": "Whether the user can manually switch modes."},
        "mode_memory_enabled": {"type": "boolean", "description": "Whether to persist mode state across sessions."},
        "api_key": {"type": "string", "description": "API key for the OM1 system."},
        "unitree_ethernet": {"type": "string", "description": "Network interface name for the Unitree connection."},
        "system_governance": {"type": "string", "description": "Governance model determining system behavior rules."},
        "knowledge_base": {
            "type": "object",
            "description": "Optional knowledge base configuration for document retrieval.",
            "properties": {
                "knowledge_base_name": {"type": "string", "description": "Name of the knowledge base directory."},
                "knowledge_base_root": {"type": "string", "description": "Root directory path for knowledge bases."}
            }
        },
        "cortex_llm": {
            "$ref": "#/definitions/cortex_llm"
        },
        "mode_router_llm": {
            "$ref": "#/definitions/cortex_llm"
        },
        "mode_router": {
            "type": "object",
            "description": "Optional runtime settings for LLM-based mode routing.",
            "properties": {
                "enabled": {"type": "boolean"},
                "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "input_keys": {
                    "type": "array",
                    "items": {"type": "string"}
                },
                "dynamic_variable_keys": {
                    "type": "array",
                    "items": {"type": "string"}
                },
                "excluded_dynamic_fields": {
                    "type": "array",
                    "items": {"type": "string"}
                },
                "allowed_transitions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["from_mode", "to_modes"],
                        "properties": {
                            "from_mode": {"type": "string"},
                            "to_modes": {
                                "type": "array",
                                "items": {"type": "string"}
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "memory": {
                    "type": "object",
                    "properties": {
                        "enabled": {"type": "boolean"},
                        "limit": {"type": "integer", "minimum": 1},
                        "max_chars": {"type": "integer", "minimum": 1}
                    },
                    "additionalProperties": true
                }
            },
            "additionalProperties": true
        },
        "voice_task_planner_llm": {
            "$ref": "#/definitions/cortex_llm"
        },
        "voice_task_planner": {
            "type": "object",
            "description": "Optional runtime settings for global voice task decomposition.",
            "properties": {
                "enabled": {"type": "boolean"},
                "context_key": {"type": "string"},
                "return_to_mode_on_complete": {"type": "string"},
                "memory": {
                    "type": "object",
                    "properties": {
                        "enabled": {"type": "boolean"}
                    },
                    "additionalProperties": true
                }
            },
            "additionalProperties": true
        },
        "global_lifecycle_hooks": {
            "type": "array",
            "description": "Hooks that execute during global system lifecycle events.",
            "items": {
                "type": "object",
                "required": ["hook_type", "handler_type", "handler_config"],
                "properties": {
                    "hook_type": {
                        "type": "string",
                        "enum": ["on_startup", "on_shutdown", "on_entry", "on_exit", "on_timeout"]
                    },
                    "handler_type": {
                        "type": "string",
                        "enum": ["message", "command", "function", "action"]
                    },
                    "handler_config": {
                        "type": "object",
                        "properties": {
                            "message": {"type": "string", "description": "Message text for message handler. Supports {variable} formatting."},
                            "tts_provider": {
                                "type": "string",
                                "enum": ["elevenlabs", "kokoro", "riva", "qwen"],
                                "default": "elevenlabs",
                                "description": "TTS provider to use for message handler announcements."
                            },
                            "command": {"type": "string", "description": "Shell command to execute for command handler. Supports {variable} formatting."},
                            "module_name": {"type": "string", "description": "Module name for function handler (without .py extension)."},
                            "function": {"type": "string", "description": "Function name to call in the module (function handler)."},
                            "action_type": {"type": "string", "description": "Action type/name to execute (action handler)."},
                            "action_config": {"type": "object", "description": "Configuration for the action (action handler)."}
                        },
                        "additionalProperties": true
                    },
                    "priority": {"type": "integer"},
                    "async_execution": {"type": "boolean"},
                    "timeout_seconds": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Timeout duration in seconds. Must be positive."
                    },
                    "on_failure": {
                        "type": "string",
                        "enum": ["log", "ignore", "abort"]
                    }
                }
            }
        },
        "modes": {
            "type": "object",
            "description": "Definitions for the various operational modes of the system.",
            "patternProperties": {
                "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "type": "object",
                    "required": ["display_name", "description", "system_prompt_base", "hertz", "agent_inputs", "agent_actions"],
                    "properties": {
                        "display_name": {"type": "string", "description": "Human-readable name for the mode."},
                        "description": {"type": "string", "description": "Description of the mode's purpose and behavior."},
                        "system_prompt_base": {"type": "string", "description": "The base system prompt used for the LLM in this mode."},
                        "system_prompt_path": {"type": "string", "description": "Optional path to a text file loaded into system_prompt_base."},
                        "hertz": {"type": "number", "description": "The frequency (in Hz) at which the mode's control loop runs.", "exclusiveMinimum": 0},
                        "timeout_seconds": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "description": "Timeout duration in seconds. Must be positive."
                        },
                        "save_interactions": {"type": "boolean"},
                        "remember_locations": {"type": "boolean"},
                        "cortex_llm": {
                            "$ref": "#/definitions/cortex_llm"
                        },
                        "voice_planner_llm": {
                            "$ref": "#/definitions/cortex_llm"
                        },
                        "voice_planner_runtime": {
                            "type": "object",
                            "properties": {
                                "inter_sub_voice_delay_seconds": {
                                    "type": "number",
                                    "minimum": 0
                                },
                                "promote_new_voice_after_plan": {
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": true
                        },
                        "lifecycle_hooks": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["hook_type", "handler_type", "handler_config"],
                                "properties": {
                                    "hook_type": {
                                        "type": "string",
                                        "enum": ["on_startup", "on_shutdown", "on_entry", "on_exit", "on_timeout"]
                                    },
                                    "handler_type": {
                                        "type": "string",
                                        "enum": ["message", "command", "function", "action"]
                                    },
                                    "handler_config": {
                                        "type": "object",
                                        "properties": {
                                            "message": {"type": "string", "description": "Message text for message handler. Supports {variable} formatting."},
                                            "tts_provider": {
                                                "type": "string",
                                                "enum": ["elevenlabs", "kokoro", "riva", "qwen"],
                                                "default": "elevenlabs",
                                                "description": "TTS provider to use for message handler announcements."
                                            },
                                            "command": {"type": "string", "description": "Shell command to execute for command handler. Supports {variable} formatting."},
                                            "module_name": {"type": "string", "description": "Module name for function handler (without .py extension)."},
                                            "function": {"type": "string", "description": "Function name to call in the module (function handler)."},
                                            "action_type": {"type": "string", "description": "Action type/name to execute (action handler)."},
                                            "action_config": {"type": "object", "description": "Configuration for the action (action handler)."}
                                        },
                                        "additionalProperties": true
                                    },
                                    "priority": {"type": "integer"},
                                    "async_execution": {"type": "boolean"},
                                    "timeout_seconds": {
                                        "type": "number",
                                        "exclusiveMinimum": 0,
                                        "description": "Timeout duration in seconds. Must be positive."
                                    },
                                    "on_failure": {
                                        "type": "string",
                                        "enum": ["log", "ignore", "abort"]
                                    }
                                }
                            }
                        },
                        "agent_inputs": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["type"],
                                "properties": {
                                    "type": {"type": "string"},
                                    "config": {"type": "object"}
                                }
                            }
                        },
                        "agent_actions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["name", "llm_label", "connector"],
                                "properties": {
                                    "name": {"type": "string"},
                                    "llm_label": {"type": "string"},
                                    "connector": {"type": "string"},
                                    "config": {"type": "object"},
                                    "exclude_from_prompt": {
                                        "type": "boolean",
                                        "default": false
                                    }
                                }
                            }
                        },
                        "action_execution_mode": {
                            "type": "string",
                            "enum": ["concurrent", "sequential", "dependencies"]
                        },
                        "action_dependencies": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {"type": "string"}
                            }
                        },
                        "action_gate": {
                            "type": "object",
                            "properties": {
                                "require_fresh_input_key": {"type": "string"},
                                "gated_actions": {
                                    "type": "array",
                                    "items": {"type": "string"}
                                },
                                "voice_carryover_ticks": {
                                    "type": "integer",
                                    "minimum": 0
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "transition_rules": {
            "type": "array",
            "description": "Rules defining how and when the system transitions between modes.",
            "items": {
                "type": "object",
                "required": ["from_mode", "to_mode", "transition_type", "priority"],
                "properties": {
                    "from_mode": {"type": "string"},
                    "to_mode": {"type": "string"},
                    "transition_type": {
                        "type": "string",
                        "enum": ["input_triggered", "time_based", "context_aware"]
                    },
                    "trigger_keywords": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "priority": {"type": "integer"},
                    "cooldown_seconds": {"type": "number"},
                    "context_conditions": {
                        "type": "object",
                        "description": "Conditions that must be met in the user context for this transition to trigger. Values can be strings, numbers, booleans, arrays, or objects with operators like 'min', 'max', 'contains', 'one_of', 'not'",
                        "additionalProperties": {
                            "anyOf": [
                                {"type": "string"},
                                {"type": "number"},
                                {"type": "boolean"},
                                {"type": "array"},
                                {
                                    "type": "object",
                                    "properties": {
                                        "min": {"type": "number"},
                                        "max": {"type": "number"},
                                        "contains": {"type": ["string", "number", "boolean"]},
                                        "one_of": {"type": "array"},
                                        "not": {}
                                    },
                                    "anyOf": [
                                        {"required": ["min"]},
                                        {"required": ["max"]},
                                        {"required": ["contains"]},
                                        {"required": ["one_of"]},
                                        {"required": ["not"]}
                                    ]
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "cortex_llm": {
            "type": "object",
            "description": "Configuration for the Cortex Large Language Model.",
            "required": ["type"],
            "properties": {
                "type": {"type": "string", "description": "The type or provider of the LLM."},
                "config": {
                    "type": "object",
                    "description": "Specific configuration parameters for the chosen LLM.",
                    "properties": {
                        "agent_name": {"type": "string"},
                        "history_length": {"type": "integer"}
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
