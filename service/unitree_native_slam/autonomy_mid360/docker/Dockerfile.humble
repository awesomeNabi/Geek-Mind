ARG BASE_IMAGE=ros:humble-ros-base
FROM ${BASE_IMAGE}

ARG BUILD_JOBS=2
ARG INSTALL_APT_DEPS=1
ARG INSTALL_ROS_DEPS=1
ARG INSTALL_PIP_DEPS=1
ARG USE_TUNA_MIRROR=1
ARG UBUNTU_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
ARG ROS2_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu
ARG PYPI_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
ARG APT_RETRIES=5
ARG APT_TIMEOUT_SECONDS=60
ARG PIP_RETRIES=5
ARG PIP_TIMEOUT_SECONDS=60
ENV DEBIAN_FRONTEND=noninteractive
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

RUN echo "[stage 1/6] Configuring package mirrors (USE_TUNA_MIRROR=${USE_TUNA_MIRROR})" \
    && if [ "${USE_TUNA_MIRROR}" = "1" ]; then \
      echo "Before rewrite:"; \
      cat /etc/apt/sources.list.d/ros2.sources; \
      # TUNA (and most China mirrors) do not publish ROS 2 deb-src indexes;
      # keep Types=deb only so apt-get update does not 404 on Sources.
      sed -i \
        -e 's/^Types:[[:space:]]*deb[[:space:]]\+deb-src/Types: deb/' \
        -e "s|http://ports.ubuntu.com/ubuntu-ports|${UBUNTU_APT_MIRROR}|g" \
        -e "s|https://ports.ubuntu.com/ubuntu-ports|${UBUNTU_APT_MIRROR}|g" \
        -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        -e "s|https://archive.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        -e "s|https://security.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
        -e "s|http://packages.ros.org/ros2/ubuntu|${ROS2_APT_MIRROR}|g" \
        -e "s|https://packages.ros.org/ros2/ubuntu|${ROS2_APT_MIRROR}|g" \
        /etc/apt/sources.list \
        /etc/apt/sources.list.d/ros2.sources; \
      echo "After rewrite:"; \
      cat /etc/apt/sources.list.d/ros2.sources; \
      if grep -RInE \
          -e '^[[:space:]]*deb(-src)?[[:space:]].*(packages\.ros\.org|ports\.ubuntu\.com|archive\.ubuntu\.com|security\.ubuntu\.com)' \
          -e '^[[:space:]]*URIs:[[:space:]].*(packages\.ros\.org|ports\.ubuntu\.com|archive\.ubuntu\.com|security\.ubuntu\.com)' \
          /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then \
        echo "ERROR: official apt hosts remain after mirror rewrite" >&2; \
        exit 1; \
      fi; \
      echo "Rewritten apt sources:"; \
      cat /etc/apt/sources.list; \
      echo "===== /etc/apt/sources.list.d/ros2.sources ====="; \
      cat /etc/apt/sources.list.d/ros2.sources; \
    fi \
    && echo "Ubuntu mirror: ${UBUNTU_APT_MIRROR}" \
    && echo "ROS 2 mirror: ${ROS2_APT_MIRROR}" \
    && echo "PyPI mirror: ${PYPI_INDEX_URL}"

RUN echo "[stage 2/6] Installing Ubuntu and ROS 2 dependencies" \
    && if [ "${INSTALL_APT_DEPS}" = "1" ] || [ "${INSTALL_ROS_DEPS}" = "1" ]; then \
      apt-get \
        -o Acquire::Retries="${APT_RETRIES}" \
        -o Acquire::http::Timeout="${APT_TIMEOUT_SECONDS}" \
        -o Acquire::https::Timeout="${APT_TIMEOUT_SECONDS}" \
        update; \
    fi \
    && if [ "${INSTALL_APT_DEPS}" = "1" ]; then \
      echo "[stage 2/6] Installing native build dependencies"; \
      apt-get \
        -o Acquire::Retries="${APT_RETRIES}" \
        -o Acquire::http::Timeout="${APT_TIMEOUT_SECONDS}" \
        -o Acquire::https::Timeout="${APT_TIMEOUT_SECONDS}" \
        install -y --no-install-recommends \
        build-essential \
        cmake \
        libapr1-dev \
        liblapacke-dev \
        libopencv-dev \
        libopen3d-dev \
        libpcl-dev \
        libusb-1.0-0-dev \
        libyaml-cpp-dev \
        python3-colcon-common-extensions \
        python3-numpy \
        python3-pip \
        tmux; \
    fi \
    && if [ "${INSTALL_ROS_DEPS}" = "1" ]; then \
      echo "[stage 2/6] Installing ROS 2 runtime dependencies"; \
      apt-get \
        -o Acquire::Retries="${APT_RETRIES}" \
        -o Acquire::http::Timeout="${APT_TIMEOUT_SECONDS}" \
        -o Acquire::https::Timeout="${APT_TIMEOUT_SECONDS}" \
        install -y --no-install-recommends \
        ros-humble-ament-cmake-auto \
        ros-humble-cv-bridge \
        ros-humble-demo-nodes-cpp \
        ros-humble-foxglove-bridge \
        ros-humble-image-transport \
        ros-humble-perception-pcl \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-rosidl-generator-dds-idl \
        ros-humble-rviz2 \
        ros-humble-sensor-msgs-py \
        ros-humble-tf-transformations \
        ros-humble-tf2-eigen \
        ros-humble-tf2-geometry-msgs \
        ros-humble-tf2-ros \
        ros-humble-tf2-sensor-msgs \
        ros-humble-urdf; \
    fi \
    && rm -rf /var/lib/apt/lists/*

RUN echo "[stage 3/6] Installing Python dependencies" \
    && if [ "${INSTALL_PIP_DEPS}" = "1" ]; then \
      if [ "${USE_TUNA_MIRROR}" = "1" ]; then \
        pip3 install \
          --no-cache-dir \
          --index-url "${PYPI_INDEX_URL}" \
          --retries "${PIP_RETRIES}" \
          --timeout "${PIP_TIMEOUT_SECONDS}" \
          pyyaml transforms3d; \
      else \
        pip3 install \
          --no-cache-dir \
          --retries "${PIP_RETRIES}" \
          --timeout "${PIP_TIMEOUT_SECONDS}" \
          pyyaml transforms3d; \
      fi; \
    fi

COPY third_party/Livox-SDK2 /tmp/Livox-SDK2
RUN echo "[stage 4/6] Building Livox-SDK2" \
    && cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2-build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/Livox-SDK2-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/Livox-SDK2-build \
    && ldconfig \
    && rm -rf /tmp/Livox-SDK2 /tmp/Livox-SDK2-build

COPY workspace/src /opt/unitree_native_slam/workspace/src
SHELL ["/bin/bash", "-lc"]
RUN echo "[stage 5/6] Building bundled ROS 2 packages with colcon" \
    && source /opt/ros/humble/setup.bash \
    && export ROS_EDITION=ROS2 DISTRO_ROS=humble \
    && colcon --log-base /tmp/unitree-native-slam-log build \
      --event-handlers console_direct+ \
      --base-paths /opt/unitree_native_slam/workspace/src \
      --build-base /tmp/unitree-native-slam-build \
      --install-base /opt/unitree_native_slam/install \
      --merge-install \
      --parallel-workers "${BUILD_JOBS}" \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DROS_EDITION=ROS2 -DDISTRO_ROS=humble \
    && rm -rf /tmp/unitree-native-slam-build /tmp/unitree-native-slam-log

RUN test -f /opt/unitree_native_slam/install/setup.bash \
    && echo "[stage 6/6] Portable Mid360 ROS 2 image is ready"

WORKDIR /workspace/unitree_native_slam
CMD ["bash", "-lc", "sleep infinity"]
