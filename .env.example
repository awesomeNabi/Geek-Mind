# Local Ubuntu 22.04 + ROS 2 Humble deployment defaults.
# Keep secrets in .env only; .env is ignored by Git.
MAGIC_DIR=/home/nvidia/MAGIC_MINI
KOALA_FETCH_CONFIG=unitree_go2_koala_nav_vision_no_arm

# Required for DashScope chat, VLM, realtime ASR, and TTS.
DASHSCOPE_API_KEY=

# Go2 DDS network. eno1 is the wired 192.168.123.0/24 interface on this host.
UNITREE_ETHERNET=eno1
CYCLONEDDS_INTERFACE=eno1
CYCLONEDDS_HOME=/home/nvidia/cyclonedds/install
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0

# Navigation runtime. docker is the validated default; host uses a local Humble colcon install.
MID360_RUNTIME=docker
MID360_WORKSPACE_DIR=/home/nvidia/MAGIC_MINI/service/unitree_native_slam/autonomy_mid360
MID360_ROS_DOMAIN_ID=0
MID360_MAPS_DIR=/home/nvidia/MAGIC_MINI/service/unitree_native_slam
MID360_IMAGE=magic-mini-mid360-nav:humble
MID360_CONTAINER=magic_mini_mid360_nav

# Direct MID360S on the USB Ethernet adapter. The launcher verifies both topics
# have live data before starting FAST-LIO or localization.
MID360_DRIVER_AUTOSTART=true
MID360_DRIVER_SESSION=magic_mid360_driver
MID360_DRIVER_LOG=/home/nvidia/MAGIC_MINI/.runtime/mid360-driver.log
MID360_DRIVER_SCRIPT=/home/nvidia/ws_mid360/scripts/start_mid360s.sh
MID360_DRIVER_SETUP=/home/nvidia/ws_mid360/install/setup.bash
MID360_DRIVER_INTERFACE=enx00e04c680d5f
MID360_DRIVER_HOST_IP=192.168.200.1
MID360_LIDAR_IP=192.168.200.20
MID360_DRIVER_TOPIC_TIMEOUT_SECONDS=20
MID360_RESET_NAVIGATION_ON_START=true
MID360_STOP_DRIVER_WITH_STACK=true
MID360_STOP_CONTAINER_WITH_STACK=true

# librealsense is built outside the uv environment so uv sync cannot remove it.
REALSENSE_VERSION=2.57.7
REALSENSE_COMMIT=9a0dd70db1a2c180b69c6c257cd2ee6120505499
REALSENSE_PREFIX=/home/nvidia/MAGIC_MINI/.local/librealsense-2.57.7
REALSENSE_PYTHONPATH=/home/nvidia/MAGIC_MINI/.local/librealsense-2.57.7/lib/python3.12/site-packages
REALSENSE_SERIAL=254843066143

# Audio devices must be connected before the full audio acceptance test.
ASR_MICROPHONE_NAME=pulse
ASR_ALSA_CARD=MINI
QWEN_TTS_PLAYBACK_MODE=stream
QWEN_TTS_ALSA_DEVICE=plughw:CARD=UACDemoV10,DEV=0
QWEN_TTS_PLAYBACK_TIMEOUT_SECONDS=30

# Optional DashScope model overrides.
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_CHAT_MODEL=deepseek-v4-pro
DASHSCOPE_PLANNER_MODEL=qwen3.6-flash
DASHSCOPE_VL_MODEL=kimi-k2.6
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Cherry

# Bundled wake-word model.
SHERPA_ONNX_KWS_MODEL_DIR=/home/nvidia/MAGIC_MINI/service/models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
SHERPA_ONNX_KWS_ENCODER=/home/nvidia/MAGIC_MINI/service/models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/encoder-epoch-12-avg-2-chunk-16-left-64.int8.onnx
SHERPA_ONNX_KWS_DECODER=/home/nvidia/MAGIC_MINI/service/models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/decoder-epoch-12-avg-2-chunk-16-left-64.onnx
SHERPA_ONNX_KWS_JOINER=/home/nvidia/MAGIC_MINI/service/models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/joiner-epoch-12-avg-2-chunk-16-left-64.int8.onnx
SHERPA_ONNX_KWS_TOKENS=/home/nvidia/MAGIC_MINI/service/models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/tokens.txt
SHERPA_ONNX_KWS_KEYWORDS_FILE=/home/nvidia/MAGIC_MINI/service/models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/keywords.txt
