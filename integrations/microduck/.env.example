# Existing projects alongside the Geek-Mind checkout.
# Paths and ports must be exported in the shell, not set in this model .env:
# export MAGIC_ROOT=/absolute/path/to/MAGIC
# export MICRODUCK_ROOT=/absolute/path/to/microduck_ros2
# Set ROS_DOMAIN_ID=84 in the shell if overriding.
# Set MICRODUCK_BRIDGE_URL=http://127.0.0.1:8766 in the shell if overriding.
# Natural language planning: use an OpenAI-compatible tool-calling model.
MAGIC_LLM_BASE_URL=
MAGIC_LLM_MODEL=
MAGIC_LLM_API_KEY=
# Optional existing MAGIC JSON5 model config (cortex_llm section).
# MAGIC_LLM_CONFIG=/absolute/path/to/model.json5

# When MAGIC_LLM_* are empty, MAGIC/.env BENCHMARK_* settings are reused.
